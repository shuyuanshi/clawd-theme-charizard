{
  "schemaVersion": 1,
  "name": "喷火龙 Charizard",
  "author": "shuyuanshi",
  "version": "0.1.0",
  "description": "喷火龙桌宠 — idle 站立 / megaY 思考 / claw 工作 / roar 权限请求 / tail-attack 报错 / gmax 完成 / 异色喷火龙+ZZZ 睡眠 / 背面行走点击反应。",

  "viewBox": { "x": 0, "y": 0, "width": 220, "height": 220 },

  "layout": {
    "contentBox": { "x": 15, "y": 28, "width": 190, "height": 188 },
    "centerX": 110,
    "baselineY": 216,
    "visibleHeightRatio": 0.85,
    "baselineBottomRatio": 0.03
  },

  "eyeTracking": { "enabled": false, "states": [] },

  "sleepSequence": { "mode": "direct" },

  "states": {
    "idle":         ["idle.gif"],
    "thinking":     ["thinking.gif"],
    "working":      ["working.gif"],
    "juggling":     ["working.gif"],
    "error":        ["error.gif"],
    "sleeping":     ["sleeping.gif"],
    "attention":    ["attention.gif"],
    "notification": ["notification.gif"],
    "sweeping":     { "fallbackTo": "working" },
    "carrying":     { "fallbackTo": "working" }
  },

  "reactions": {
    "clickRight": { "file": "run-right.gif", "duration": 2500 },
    "clickLeft":  { "file": "run-left.gif",  "duration": 2500 }
  },

  "hitBoxes": {
    "default":  { "x": 15, "y": 28, "w": 190, "h": 188 },
    "sleeping": { "x": 15, "y": 90, "w": 190, "h": 126 }
  },

  "miniMode": { "supported": false }
}
